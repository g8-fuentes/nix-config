{
  pkgs,
  lib,
  outputs,
  ...
}:
{
  home.packages = lib.mkIf (pkgs.stdenv.hostPlatform.isLinux) (
    outputs.lib.available pkgs [
      "appimage-run"
      "ffmpeg"
      "pciutils"
      "mesa-demos"
      "pulseaudio"
      "unzip"
      "chafa"
      "lshw"
      "imagemagick"
      "ffmpegthumbnailer"
      [
        "poppler-utils"
        "poppler_utils"
      ]
      "xdotool"
      "playerctl"
      [
        "xprop"
        "xorg.xprop"
      ]
      "cacert"
      "wget"
      "usbutils"
    ]
  );
}
